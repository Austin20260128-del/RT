        const select = document.getElementById('bookRoomSelect');
        if (!select) return;

        select.innerHTML = ROOMS.map(r => `
          <option value="${r.id}" ${r.id === selectedRoomId ? 'selected' : ''}>
            ${r.code} ${r.name} (${r.floor} · 上限 ${r.capacity} 人)
          </option>
        `).join('');

        updateRoomHint();
      }

      function populateTimeOptions() {
        const startSelect = document.getElementById('bookStartTime');
        const endSelect = document.getElementById('bookEndTime');
        if (!startSelect || !endSelect) return;

        const options = [];
        for (let m = 8 * 60; m <= 19 * 60 + 30; m += 30) {
          options.push(minutesToTime(m));
        }

        startSelect.innerHTML = options.slice(0, -1).map(t => `<option value="${t}">${t}</option>`).join('');
        endSelect.innerHTML = options.slice(1).map(t => `<option value="${t}">${t}</option>`).join('');
      }

      function updateRoomHint() {
        const select = document.getElementById('bookRoomSelect');
        const hint = document.getElementById('bookRoomHint');
        const attendeesInput = document.getElementById('bookAttendees');
        const warning = document.getElementById('labelCapacityWarning');

        if (!select || !hint) return;
        const room = ROOMS.find(r => r.id === select.value);
        if (room) {
          hint.innerHTML = `
            <span class="inline-block w-2 h-2 rounded-full bg-${room.color}-500 mr-1.5"></span>
            <span>${room.floor} · 建議容納：${room.capacity} 人 · 配備：${room.amenityLabels.join(', ')}</span>
          `;
          if (attendeesInput && warning) {
            const count = parseInt(attendeesInput.value, 10) || 0;
            if (count > room.capacity) {
              warning.classList.remove('hidden');
              warning.textContent = `⚠️ 超出 ${room.name} 容納上限 (${room.capacity}人)`;
            } else {
              warning.classList.add('hidden');
            }
          }
        }
        checkBookingConflict();
      }

      function checkBookingConflict() {
        const roomSelect = document.getElementById('bookRoomSelect');
        const dateInput = document.getElementById('bookDateInput');
        const startTimeSelect = document.getElementById('bookStartTime');
        const endTimeSelect = document.getElementById('bookEndTime');
        const banner = document.getElementById('bookingConflictBanner');
        const bannerText = document.getElementById('bookingConflictText');
        const submitBtn = document.getElementById('btnSubmitBooking');

        if (!roomSelect || !dateInput || !startTimeSelect || !endTimeSelect || !banner) return false;

        const roomId = roomSelect.value;
        const date = dateInput.value;
        const start = startTimeSelect.value;
        const end = endTimeSelect.value;

        // Validity check on start < end
        if (timeToMinutes(start) >= timeToMinutes(end)) {
          banner.classList.remove('hidden');
          bannerText.innerHTML = '<strong>時間設定錯誤：</strong>結束時間必須晚於開始時間！';
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
          return true;
        }

        // Search conflict in state
        const conflict = state.bookings.find(b => {
          return b.roomId === roomId && b.date === date && isTimeOverlapping(start, end, b.startTime, b.endTime);
        });

        if (conflict) {
          banner.classList.remove('hidden');
          bannerText.innerHTML = `
            <div>
              <strong class="font-bold">時段衝突警示：</strong>
              該時段已被 <span class="font-semibold underline">${conflict.person}</span> 預約「${conflict.title}」(${conflict.startTime} - ${conflict.endTime})，請更換時段或會議室！
            </div>
          `;
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
          return true;
        } else {
          banner.classList.add('hidden');
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          return false;
        }
      }

      function openBookingModal(initialRoomId = '', initialStartTime = '', initialDate = '') {
        const modal = document.getElementById('modalBooking');
        const dateInput = document.getElementById('bookDateInput');
        const startTimeSelect = document.getElementById('bookStartTime');
        const endTimeSelect = document.getElementById('bookEndTime');

        populateBookingFormRoomOptions(initialRoomId || ROOMS[0].id);

        if (dateInput) {
          dateInput.value = initialDate || state.currentDate;
        }

        if (startTimeSelect && endTimeSelect) {
          if (initialStartTime) {
            startTimeSelect.value = initialStartTime;
            const end = minutesToTime(timeToMinutes(initialStartTime) + 60);
            endTimeSelect.value = end;
          } else {
            startTimeSelect.value = '09:00';
            endTimeSelect.value = '10:00';
          }
        }

        updateRoomHint();
        checkBookingConflict();

        if (modal) {
          modal.classList.remove('hidden');
        }
      }

      function closeBookingModal() {
        const modal = document.getElementById('modalBooking');
        if (modal) modal.classList.add('hidden');
      }

      // Details Modal
      function openDetailsModal(bookingId) {
        const booking = state.bookings.find(b => b.id === bookingId);
        if (!booking) return;

        state.selectedBookingForDetails = booking;

        const modal = document.getElementById('modalDetails');
        const room = ROOMS.find(r => r.id === booking.roomId) || { code: '??', name: '會議室' };

        document.getElementById('detailTitle').textContent = booking.title;
        document.getElementById('detailRoomBadge').textContent = `${room.code} ${room.name}`;
        document.getElementById('detailDate').textContent = `${booking.date} (${getWeekdayName(booking.date)})`;
        document.getElementById('detailTime').textContent = `${booking.startTime} - ${booking.endTime}`;
        document.getElementById('detailPerson').textContent = booking.person;
        document.getElementById('detailDept').textContent = booking.dept;
        document.getElementById('detailAttendees').textContent = `${booking.attendees} 人`;

        const equipEl = document.getElementById('detailEquipment');
        if (booking.equipment && booking.equipment.length > 0) {
          equipEl.textContent = booking.equipment.join('、');
        } else {
          equipEl.textContent = '無特殊設備需求';
        }

        const notesContainer = document.getElementById('detailNotesContainer');
        const notesEl = document.getElementById('detailNotes');
        if (booking.notes && booking.notes.trim() !== '') {
          notesContainer.classList.remove('hidden');
          notesEl.textContent = booking.notes;
        } else {
          notesContainer.classList.add('hidden');
        }

        if (modal) modal.classList.remove('hidden');
      }

      function closeDetailsModal() {
        const modal = document.getElementById('modalDetails');
        if (modal) modal.classList.add('hidden');
        state.selectedBookingForDetails = null;
      }

      // Cancellation Confirmation Modal (In-page dialog, avoiding window.confirm)
      function openConfirmCancelModal(bookingId) {
        state.pendingCancelId = bookingId;
        const booking = state.bookings.find(b => b.id === bookingId);
        if (!booking) return;

        const modal = document.getElementById('modalConfirmCancel');
        const desc = document.getElementById('confirmCancelDesc');
        if (desc) {
          desc.textContent = `即將取消「${booking.title}」(${booking.date} ${booking.startTime}-${booking.endTime})，取消後時段將立即釋出給所有人預約。`;
        }
        if (modal) modal.classList.remove('hidden');
      }

      function closeConfirmCancelModal() {
        const modal = document.getElementById('modalConfirmCancel');
        if (modal) modal.classList.add('hidden');
        state.pendingCancelId = null;
      }

      // Share Modal
      function openShareModal() {
        const modal = document.getElementById('modalShare');
        const input = document.getElementById('shareUrlInput');
        // Simulated live URL with current query parameters
        const url = `${window.location.origin}${window.location.pathname}#date=${state.currentDate}`;
        if (input) input.value = url;
        if (modal) modal.classList.remove('hidden');
      }

      function closeShareModal() {
        const modal = document.getElementById('modalShare');
        if (modal) modal.classList.add('hidden');
      }

      // My Bookings Modal
      function openMyBookingsModal() {
        const modal = document.getElementById('modalMyBookings');
        renderMyBookingsList();
        if (modal) modal.classList.remove('hidden');
      }

      function closeMyBookingsModal() {
        const modal = document.getElementById('modalMyBookings');
        if (modal) modal.classList.add('hidden');
      }

      function renderMyBookingsList(searchTerm = '') {
        const container = document.getElementById('myBookingsContainer');
        const countText = document.getElementById('myBookingsCountText');
        if (!container) return;

        const filtered = state.bookings
          .filter(b => {
            if (!searchTerm) return true;
            const term = searchTerm.toLowerCase();
            return b.title.toLowerCase().includes(term) ||
                   b.person.toLowerCase().includes(term) ||
                   b.dept.toLowerCase().includes(term);
          })
          .sort((a, b) => {
            if (a.date !== b.date) return a.date.localeCompare(b.date);
            return timeToMinutes(a.startTime) - timeToMinutes(b.startTime);
          });

        if (countText) {
          countText.textContent = `共 ${filtered.length} 筆預約`;
        }

        if (filtered.length === 0) {
          container.innerHTML = `
            <div class="p-8 text-center text-slate-400 text-xs">
              查無相符的預約紀錄
            </div>
          `;
          return;
        }

        let html = '';
        filtered.forEach(b => {
          const room = ROOMS.find(r => r.id === b.roomId) || { code: '??', name: '會議室' };
          html += `
            <div class="p-3.5 hover:bg-slate-50 flex items-center justify-between text-xs transition">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-slate-900">${b.title}</span>
                  <span class="px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700 font-semibold text-[11px]">${room.code} ${room.name}</span>
                </div>
                <div class="text-slate-500 mt-1">
                  📅 ${b.date} · ⏰ ${b.startTime}-${b.endTime} · 👤 ${b.person} (${b.dept})
                </div>
              </div>
              <div class="flex items-center space-x-2">
                <button type="button" class="btn-item-details px-2.5 py-1 text-slate-600 hover:text-indigo-600 font-medium" data-booking-id="${b.id}">
                  詳情
                </button>
                <button type="button" class="btn-item-cancel px-2.5 py-1 text-rose-600 hover:bg-rose-50 rounded font-medium" data-booking-id="${b.id}">
                  取消
                </button>
              </div>
            </div>
          `;
        });

        container.innerHTML = html;
      }

      // ------------------------------------------------------------
      // 8. Event Listeners & Binding
      // ------------------------------------------------------------
      function initEventListeners() {
        // Date navigation
        document.getElementById('btnPrevDay').addEventListener('click', () => {
          state.currentDate = addDays(state.currentDate, -1);
          renderActiveView();
        });

        document.getElementById('btnToday').addEventListener('click', () => {
          state.currentDate = formatTodayDate();
          renderActiveView();
        });

        document.getElementById('btnTomorrow').addEventListener('click', () => {
          state.currentDate = addDays(formatTodayDate(), 1);
          renderActiveView();
        });

        document.getElementById('btnNextDay').addEventListener('click', () => {
          state.currentDate = addDays(state.currentDate, 1);
          renderActiveView();
        });

        document.getElementById('inputCurrentDate').addEventListener('change', (e) => {
          if (e.target.value) {
            state.currentDate = e.target.value;
            renderActiveView();
          }
        });

        // Filter dropdowns
        document.getElementById('selectCapacityFilter').addEventListener('change', (e) => {
          state.capacityFilter = e.target.value;
          renderActiveView();
        });

        document.getElementById('selectAmenityFilter').addEventListener('change', (e) => {
          state.amenityFilter = e.target.value;
          renderActiveView();
        });

        // View tabs
        document.getElementById('tabViewGrid').addEventListener('click', () => {
          state.activeView = 'grid';
          renderActiveView();
        });

        document.getElementById('tabViewRooms').addEventListener('click', () => {
          state.activeView = 'rooms';
          renderActiveView();
        });

        document.getElementById('tabViewList').addEventListener('click', () => {
          state.activeView = 'list';
          renderActiveView();
        });

        // Quick book button in top header
        document.getElementById('btnQuickBook').addEventListener('click', () => {
          openBookingModal();
        });

        // Share buttons
        document.getElementById('btnOpenShare').addEventListener('click', () => {
          openShareModal();
        });

        document.getElementById('btnCloseShareModal').addEventListener('click', () => {
          closeShareModal();
        });

        document.getElementById('btnDoneShare').addEventListener('click', () => {
          closeShareModal();
        });

        document.getElementById('btnCopyShareUrl').addEventListener('click', () => {
          const input = document.getElementById('shareUrlInput');
          copyToClipboard(input.value, '預約專屬網址已複製到剪貼簿！');
        });

        document.getElementById('btnCopyDirectShareLink').addEventListener('click', () => {
          const url = `${window.location.origin}${window.location.pathname}#date=${state.currentDate}`;
          copyToClipboard(url, '當前頁面即時預約連結已成功複製！');
        });

        // My Bookings
        document.getElementById('btnOpenMyBookings').addEventListener('click', () => {
          openMyBookingsModal();
        });

        document.getElementById('btnCloseMyBookingsModal').addEventListener('click', () => {
          closeMyBookingsModal();
        });

        document.getElementById('btnDoneMyBookings').addEventListener('click', () => {
          closeMyBookingsModal();
        });

        document.getElementById('inputSearchMyBookings').addEventListener('input', (e) => {
          renderMyBookingsList(e.target.value);
        });

        // Reset Data
        document.getElementById('btnResetData').addEventListener('click', () => {
          const fresh = generateInitialMockBookings(formatTodayDate());
          saveBookings(fresh);
          renderActiveView();
          showToast('已重設為預設範例預約資料！', 'info');
        });

        // Booking Modal controls
        document.getElementById('btnCloseBookingModal').addEventListener('click', () => {
          closeBookingModal();
        });

        document.getElementById('btnCancelBookingModal').addEventListener('click', () => {
          closeBookingModal();
        });

        document.getElementById('bookRoomSelect').addEventListener('change', () => {
          updateRoomHint();
        });

        document.getElementById('bookDateInput').addEventListener('change', () => {
          checkBookingConflict();
        });

        document.getElementById('bookStartTime').addEventListener('change', () => {
          const start = document.getElementById('bookStartTime').value;
          const endSelect = document.getElementById('bookEndTime');
          // auto push end time 1 hour forward if start >= end
          if (timeToMinutes(start) >= timeToMinutes(endSelect.value)) {
            endSelect.value = minutesToTime(timeToMinutes(start) + 60);
          }
          checkBookingConflict();
        });

        document.getElementById('bookEndTime').addEventListener('change', () => {
          checkBookingConflict();
        });

        document.getElementById('bookAttendees').addEventListener('input', () => {
          updateRoomHint();
        });

        // Quick duration buttons
        document.querySelectorAll('.btn-duration').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const minutes = parseInt(e.currentTarget.getAttribute('data-minutes'), 10);
            const startVal = document.getElementById('bookStartTime').value;
            const newEnd = minutesToTime(timeToMinutes(startVal) + minutes);
            const endSelect = document.getElementById('bookEndTime');
            if (endSelect) {
              endSelect.value = newEnd;
            }
            checkBookingConflict();
          });
        });

        // Form Submit
        document.getElementById('formBooking').addEventListener('submit', (e) => {
          e.preventDefault();
          if (checkBookingConflict()) {
            return;
          }

          const roomId = document.getElementById('bookRoomSelect').value;
          const date = document.getElementById('bookDateInput').value;
          const startTime = document.getElementById('bookStartTime').value;
          const endTime = document.getElementById('bookEndTime').value;
          const title = document.getElementById('bookTitle').value.trim();
          const person = document.getElementById('bookPerson').value.trim();
          const dept = document.getElementById('bookDept').value.trim();
          const attendees = parseInt(document.getElementById('bookAttendees').value, 10) || 1;
          const notes = document.getElementById('bookNotes').value.trim();

          const equipment = [];
          if (document.getElementById('chkReqVideo').checked) equipment.push('遠距視訊鏡頭');
          if (document.getElementById('chkReqBoard').checked) equipment.push('白板與筆組');
          if (document.getElementById('chkReqProjector').checked) equipment.push('無線簡報投屏');
          if (document.getElementById('chkReqMic').checked) equipment.push('外接麥克風');
          if (document.getElementById('chkReqTea').checked) equipment.push('外賓茶水接待');

          const newBooking = {
            id: 'b-' + Date.now(),
            roomId,
            date,
            startTime,
            endTime,
            title,
            person,
            dept,
            attendees,
            equipment,
            notes
          };

          const updated = [...state.bookings, newBooking];
          saveBookings(updated);

          // Update current viewed date to match booking date
          state.currentDate = date;
          closeBookingModal();
          renderActiveView();

          // Reset form fields
          document.getElementById('bookTitle').value = '';
          document.getElementById('bookPerson').value = '';
          document.getElementById('bookDept').value = '';
          document.getElementById('bookNotes').value = '';
          document.getElementById('chkReqVideo').checked = false;
          document.getElementById('chkReqBoard').checked = false;
          document.getElementById('chkReqProjector').checked = false;
          document.getElementById('chkReqMic').checked = false;
          document.getElementById('chkReqTea').checked = false;

          const room = ROOMS.find(r => r.id === roomId);
          showToast(`🎉 預約成功！已為您保留 ${room.name} (${date} ${startTime}-${endTime})`, 'success');
        });

        // Details Modal actions
        document.getElementById('btnCloseDetailsModal').addEventListener('click', () => {
          closeDetailsModal();
        });

        document.getElementById('btnCopyInvite').addEventListener('click', () => {
          const b = state.selectedBookingForDetails;
          if (!b) return;
          const room = ROOMS.find(r => r.id === b.roomId);
          const text = `【會議預約通知】\n主題：${b.title}\n地點：${room.code} ${room.name} (${room.floor})\n時間：${b.date} ${b.startTime} - ${b.endTime}\n預約人：${b.person} (${b.dept})\n出席人數：${b.attendees} 人\n備註：${b.notes || '無'}`;
          copyToClipboard(text, '會議邀請文字已複製到剪貼簿！');
        });

        document.getElementById('btnTriggerCancelBooking').addEventListener('click', () => {
          const b = state.selectedBookingForDetails;
          if (!b) return;
          closeDetailsModal();
          openConfirmCancelModal(b.id);
        });

        // Cancellation Confirmation Modal actions
        document.getElementById('btnAbortCancel').addEventListener('click', () => {
          closeConfirmCancelModal();
        });

        document.getElementById('btnExecuteCancel').addEventListener('click', () => {
          const id = state.pendingCancelId;
          if (id) {
            const updated = state.bookings.filter(b => b.id !== id);
            saveBookings(updated);
            renderActiveView();
            renderMyBookingsList();
            showToast('已成功取消該會議室預約，時段已釋出！', 'info');
          }
          closeConfirmCancelModal();
        });

        // Event delegation for dynamic buttons (slots, view booking, card booking, etc.)
        document.addEventListener('click', (e) => {
          // 1. Click on Free Slot to Book
          const slotBtn = e.target.closest('.btn-slot-book');
          if (slotBtn) {
            const roomId = slotBtn.getAttribute('data-room-id');
            const startTime = slotBtn.getAttribute('data-start-time');
            const date = slotBtn.getAttribute('data-date');
            openBookingModal(roomId, startTime, date);
            return;
          }

          // 2. Click on Booked slot or list item to view details
          const viewBtn = e.target.closest('.btn-view-booking');
          if (viewBtn) {
            const bookingId = viewBtn.getAttribute('data-booking-id');
            openDetailsModal(bookingId);
            return;
          }

          // 3. Click on "預約此會議室" in Room Cards
          const cardBookBtn = e.target.closest('.btn-card-book');
          if (cardBookBtn) {
            const roomId = cardBookBtn.getAttribute('data-room-id');
            openBookingModal(roomId);
            return;
          }

          // 4. Click details or cancel in My Bookings list
          const itemDetailsBtn = e.target.closest('.btn-item-details');
          if (itemDetailsBtn) {
            const bookingId = itemDetailsBtn.getAttribute('data-booking-id');
            closeMyBookingsModal();
            openDetailsModal(bookingId);
            return;
          }

          const itemCancelBtn = e.target.closest('.btn-item-cancel');
          if (itemCancelBtn) {
            const bookingId = itemCancelBtn.getAttribute('data-booking-id');
            closeMyBookingsModal();
            openConfirmCancelModal(bookingId);
            return;
          }
        });
      }

      // ------------------------------------------------------------
      // 9. App Initialization
      // ------------------------------------------------------------
      function init() {
        state.currentDate = formatTodayDate();
        state.bookings = loadBookings();

        populateTimeOptions();
        populateBookingFormRoomOptions();
        initEventListeners();
        renderActiveView();
      }

      // Run on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</body>
</html>
