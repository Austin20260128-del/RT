<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MeetFlow 會議室預約與即時時段查詢系統</title>
  <!-- Tailwind CSS 3.4.17 -->
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Top Navigation Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo & Title -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-400 flex items-center justify-center text-white shadow-md shadow-indigo-100 flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span class="text-xl font-bold tracking-tight text-slate-900">MeetFlow</span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                即時同步中
              </span>
            </div>
            <p class="text-xs text-slate-500 hidden sm:block">開放式即時會議室預約平台 · 免登入直接查詢與登記</p>
          </div>
        </div>

        <!-- Quick Top Actions -->
        <div class="flex items-center space-x-2 sm:space-x-3">
          <!-- Share URL Button -->
          <button id="btnOpenShare" class="inline-flex items-center px-3 py-2 border border-slate-200 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition shadow-sm">
            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
            </svg>
            <span class="hidden md:inline">分享網址</span>
          </button>

          <!-- My Bookings Button -->
          <button id="btnOpenMyBookings" class="inline-flex items-center px-3 py-2 border border-slate-200 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition shadow-sm relative">
            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
            <span>預約清單</span>
            <span id="badgeBookingCount" class="ml-1.5 px-1.5 py-0.2 bg-indigo-100 text-indigo-700 rounded-full text-xs font-semibold">0</span>
          </button>

          <!-- Primary Book Button -->
          <button id="btnQuickBook" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-semibold rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition shadow-sm shadow-indigo-200">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>立即預約</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Subheader / Date Picker & Filter Bar -->
  <section class="bg-white border-b border-slate-200 px-4 sm:px-6 lg:px-8 py-3.5 shadow-sm">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <!-- Date Controls -->
      <div class="flex items-center flex-wrap gap-2">
        <div class="inline-flex items-center bg-slate-100 p-1 rounded-lg border border-slate-200">
          <button id="btnPrevDay" class="p-1.5 rounded-md hover:bg-white hover:shadow-xs text-slate-600 transition" title="前一天">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <button id="btnToday" class="px-2.5 py-1 text-xs font-semibold rounded-md hover:bg-white hover:shadow-xs text-slate-700 transition">
            今天
          </button>
          <button id="btnTomorrow" class="px-2.5 py-1 text-xs font-semibold rounded-md hover:bg-white hover:shadow-xs text-slate-700 transition">
            明天
          </button>
          <button id="btnNextDay" class="p-1.5 rounded-md hover:bg-white hover:shadow-xs text-slate-600 transition" title="後一天">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>

        <!-- Date Input & Friendly Display -->
        <div class="flex items-center space-x-2">
          <input type="date" id="inputCurrentDate" class="bg-white border border-slate-300 text-slate-800 text-sm rounded-lg px-2.5 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-medium">
          <span id="labelDateWeek" class="text-sm font-semibold text-slate-700 hidden sm:inline-block"></span>
        </div>
      </div>

      <!-- Filters & View Switchers -->
      <div class="flex items-center flex-wrap gap-2.5 justify-between md:justify-end">
        <!-- Room Capacity Filter -->
        <select id="selectCapacityFilter" class="bg-white border border-slate-300 text-slate-700 text-xs rounded-lg px-2.5 py-1.5 focus:ring-indigo-500 focus:border-indigo-500 font-medium">
          <option value="all">所有容納人數</option>
          <option value="small">4人小型 (小型討論)</option>
          <option value="medium">8-12人中型 (專案團隊)</option>
          <option value="large">16-30人大型 (全體/大會)</option>
        </select>

        <!-- Equipment Filter -->
        <select id="selectAmenityFilter" class="bg-white border border-slate-300 text-slate-700 text-xs rounded-lg px-2.5 py-1.5 focus:ring-indigo-500 focus:border-indigo-500 font-medium">
          <option value="all">所有設備配備</option>
          <option value="video">具備視訊視聽系統</option>
          <option value="board">具備電子/玻璃白板</option>
          <option value="projector">具備高畫質投影</option>
        </select>

        <!-- View Tabs -->
        <div class="inline-flex rounded-lg border border-slate-200 bg-slate-100 p-0.5">
          <button id="tabViewGrid" class="px-3 py-1 text-xs font-semibold rounded-md transition shadow-sm bg-white text-indigo-700">
            時程矩陣
          </button>
          <button id="tabViewRooms" class="px-3 py-1 text-xs font-medium rounded-md transition text-slate-600 hover:text-slate-900">
            會議室卡片
          </button>
          <button id="tabViewList" class="px-3 py-1 text-xs font-medium rounded-md transition text-slate-600 hover:text-slate-900">
            今日清單
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Notice Banner / Usage Hint -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="bg-gradient-to-r from-indigo-50 via-sky-50 to-emerald-50 border border-indigo-100/80 rounded-xl p-3 sm:p-4 flex items-start sm:items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <span class="p-2 rounded-lg bg-indigo-500 text-white flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </span>
        <div class="text-xs sm:text-sm text-slate-700">
          <span class="font-bold text-slate-900">預約操作說明：</span>
          在時程表上直接點擊 <span class="inline-block px-1.5 py-0.5 bg-emerald-100 text-emerald-800 rounded font-semibold text-xs border border-emerald-200">+ 可預約</span> 時段即可直接登記；點選已預約的會議卡片可查閱詳情或取消。
        </div>
      </div>
      <div class="flex items-center space-x-3 text-xs text-slate-500 flex-shrink-0">
        <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-emerald-400 mr-1.5"></span>空閒時段</span>
        <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500 mr-1.5"></span>已預約</span>
      </div>
    </div>
  </div>

  <!-- Main Content Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

    <!-- VIEW 1: Time Schedule Grid / Matrix View -->
    <div id="viewContainerGrid" class="space-y-4">
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <div class="min-w-[850px]">
            <!-- Room Columns Header -->
            <div id="gridHeaderRow" class="grid grid-cols-6 border-b border-slate-200 bg-slate-50/80 text-xs font-semibold text-slate-700 sticky top-0 z-10">
              <!-- First cell: Time header -->
              <div class="p-3.5 border-r border-slate-200 flex items-center justify-center text-slate-500 bg-slate-100/70">
                <svg class="w-4 h-4 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>時段 / 會議室</span>
              </div>
              <!-- Generated room header columns here -->
            </div>

            <!-- Time Slots Grid Rows -->
            <div id="gridBodyRows" class="divide-y divide-slate-100 text-sm">
              <!-- Dynamically populated rows 08:00 - 20:00 -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- VIEW 2: Room Cards Detailed View -->
    <div id="viewContainerRooms" class="hidden">
      <div id="roomCardsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Dynamically rendered room cards -->
      </div>
    </div>

    <!-- VIEW 3: Daily Timeline / Booking List View -->
    <div id="viewContainerList" class="hidden">
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50">
          <div>
            <h3 class="font-bold text-slate-800 text-base" id="listDateHeading">當日會議排程清單</h3>
            <p class="text-xs text-slate-500">依時間先後順序排列，點擊可查看詳細資料</p>
          </div>
          <div class="flex items-center space-x-2">
            <span id="listTotalMeetingsBadge" class="px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-lg text-xs font-semibold border border-indigo-100">
              共 0 場會議
            </span>
          </div>
        </div>
        <div id="dailyBookingTable" class="divide-y divide-slate-100">
          <!-- Rendered list items -->
        </div>
      </div>
    </div>

  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-6 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <div class="flex items-center space-x-2">
        <span class="font-semibold text-slate-700">MeetFlow 會議室即時預約系統</span>
        <span>•</span>
        <span>隨選即用免安裝</span>
      </div>
      <div class="flex items-center space-x-4">
        <button id="btnResetData" class="text-slate-400 hover:text-rose-600 transition" title="清除測試資料並恢復預設">
          重設範例資料
        </button>
        <button id="btnCopyDirectShareLink" class="text-indigo-600 hover:text-indigo-800 font-medium">
          複製本頁直接預約連結
        </button>
      </div>
    </div>
  </footer>

  <!-- ============================================================ -->
  <!-- MODAL 1: Booking Dialog (即時預約彈窗) -->
  <!-- ============================================================ -->
  <div id="modalBooking" class="fixed inset-0 z-50 overflow-y-auto hidden bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-lg w-full overflow-hidden transform transition-all my-8 animate-in fade-in zoom-in-95">
      <!-- Modal Header -->
      <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 px-6 py-4 text-white flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <h3 class="text-lg font-bold">預約會議室</h3>
        </div>
        <button id="btnCloseBookingModal" class="text-indigo-200 hover:text-white rounded-lg p-1 hover:bg-indigo-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Body Form -->
      <form id="formBooking" class="p-6 space-y-4 text-left">
        <!-- Room Selector -->
        <div>
          <label for="bookRoomSelect" class="block text-xs font-semibold text-slate-700 mb-1">
            選擇會議室 <span class="text-rose-500">*</span>
          </label>
          <select id="bookRoomSelect" required class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-medium">
            <!-- Populated via JS -->
          </select>
          <div id="bookRoomHint" class="text-xs text-slate-500 mt-1 flex items-center">
            <!-- Room meta info populated dynamically -->
          </div>
        </div>

        <!-- Date & Time Row -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label for="bookDateInput" class="block text-xs font-semibold text-slate-700 mb-1">
              日期 <span class="text-rose-500">*</span>
            </label>
            <input type="date" id="bookDateInput" required class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-2.5 py-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div>
            <label for="bookStartTime" class="block text-xs font-semibold text-slate-700 mb-1">
              開始時間 <span class="text-rose-500">*</span>
            </label>
            <select id="bookStartTime" required class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-2.5 py-2 focus:ring-indigo-500 focus:border-indigo-500">
              <!-- Populated timeslots -->
            </select>
          </div>
          <div>
            <label for="bookEndTime" class="block text-xs font-semibold text-slate-700 mb-1">
              結束時間 <span class="text-rose-500">*</span>
            </label>
            <select id="bookEndTime" required class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-2.5 py-2 focus:ring-indigo-500 focus:border-indigo-500">
              <!-- Populated timeslots -->
            </select>
          </div>
        </div>

        <!-- Quick Duration Shortcuts -->
        <div class="flex items-center space-x-2 pt-0.5">
          <span class="text-xs text-slate-500">快速時長：</span>
          <button type="button" class="btn-duration px-2 py-0.5 text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 rounded border border-slate-200 transition" data-minutes="30">30分鐘</button>
          <button type="button" class="btn-duration px-2 py-0.5 text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 rounded border border-slate-200 transition" data-minutes="60">1小時</button>
          <button type="button" class="btn-duration px-2 py-0.5 text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 rounded border border-slate-200 transition" data-minutes="90">1.5小時</button>
          <button type="button" class="btn-duration px-2 py-0.5 text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 rounded border border-slate-200 transition" data-minutes="120">2小時</button>
        </div>

        <!-- Conflict Alert Banner (Dynamic) -->
        <div id="bookingConflictBanner" class="hidden p-3 bg-rose-50 border border-rose-200 rounded-lg text-xs text-rose-800 flex items-start space-x-2">
          <svg class="w-4 h-4 text-rose-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <div id="bookingConflictText">
            時段衝突警示
          </div>
        </div>

        <!-- Meeting Title -->
        <div>
          <label for="bookTitle" class="block text-xs font-semibold text-slate-700 mb-1">
            會議主題 / 目的 <span class="text-rose-500">*</span>
          </label>
          <input type="text" id="bookTitle" required placeholder="例如：Q4 產品進度同步會議" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
        </div>

        <!-- Booker Information -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="bookPerson" class="block text-xs font-semibold text-slate-700 mb-1">
              預約人姓名 <span class="text-rose-500">*</span>
            </label>
            <input type="text" id="bookPerson" required placeholder="王小明 (Alex)" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div>
            <label for="bookDept" class="block text-xs font-semibold text-slate-700 mb-1">
              部門 / 聯絡資訊 <span class="text-rose-500">*</span>
            </label>
            <input type="text" id="bookDept" required placeholder="研發部 / ext. 2301" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>
        </div>

        <!-- Attendees Count -->
        <div>
          <label for="bookAttendees" class="block text-xs font-semibold text-slate-700 mb-1">
            預估與會人數
          </label>
          <div class="flex items-center space-x-3">
            <input type="number" id="bookAttendees" min="1" max="100" value="4" class="w-32 bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-lg px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500">
            <span id="labelCapacityWarning" class="text-xs text-amber-600 hidden font-medium">⚠️ 超出此會議室建議容納上限</span>
          </div>
        </div>

        <!-- Special Requirements Checkboxes -->
        <div>
          <span class="block text-xs font-semibold text-slate-700 mb-1.5">設備借用需求</span>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs text-slate-700">
            <label class="flex items-center space-x-1.5">
              <input type="checkbox" id="chkReqVideo" class="rounded text-indigo-600 focus:ring-indigo-500">
              <span>遠距視訊鏡頭</span>
            </label>
            <label class="flex items-center space-x-1.5">
              <input type="checkbox" id="chkReqBoard" class="rounded text-indigo-600 focus:ring-indigo-500">
              <span>白板與筆組</span>
            </label>
            <label class="flex items-center space-x-1.5">
              <input type="checkbox" id="chkReqProjector" class="rounded text-indigo-600 focus:ring-indigo-500">
              <span>無線簡報投屏</span>
            </label>
            <label class="flex items-center space-x-1.5">
              <input type="checkbox" id="chkReqMic" class="rounded text-indigo-600 focus:ring-indigo-500">
              <span>外接麥克風</span>
            </label>
            <label class="flex items-center space-x-1.5">
