    function normalizeServiceCat(val) {
      if (!val) return '未填';
      const s = String(val).trim();
      const mains = ['一般叫修', '保固', '裝機', '合約保養', '合約叫修', '一般保養', '教育訓練'];
      for (const m of mains) { if (s.startsWith(m)) return m; }
      return '其他';
    }

    function normalizeWarranty(val) {
      if (!val) return '未填';
      const s = String(val).trim();
      if (s.includes('保固內')) return '保固內';
      if (s.includes('保固外-有償')) return '保固外-有償';
      if (s.includes('保固外')) return '保固外-無償/其他';
      if (s.includes('維護合約')) return '維護合約';
      if (s.includes('裝機')) return '裝機';
      return '其他/未填';
    }

    // 支援匯入新工單表格 (.xlsx / .xls / .csv)
    document.getElementById('fileInput').addEventListener('change', async (e) => {
      const files = Array.from(e.target.files);
      if (!files.length) return;

      let addedRows = 0;
      for (const file of files) {
        const data = await file.arrayBuffer();
        const workbook = XLSX.read(data, { type: 'array' });
        let sheetName = workbook.SheetNames.find(n => n.includes('RepairSky')) || workbook.SheetNames[0];
        const sheet = workbook.Sheets[sheetName];
        const rows = XLSX.utils.sheet_to_json(sheet, { defval: '' });

        const fileYearMatch = file.name.match(/20\d{2}/);
        const fallbackYear = fileYearMatch ? fileYearMatch[0] : '未知';

        rows.forEach((r, idx) => {
          let orderId = String(r['維修單編號'] || '').trim();
          if (orderId.endsWith('.0')) orderId = orderId.slice(0, -2);
          if (!orderId && !r['狀態'] && !r['產品分類']) return;

          const rawDate = String(r['服務日期/時間'] || r['報修日期'] || '').trim();
          let yr = fallbackYear;
          let mo = 1;
          if (rawDate.length >= 7) {
            const dMatch = rawDate.match(/(20\d{2})[-/](\d{1,2})/);
            if (dMatch) {
              yr = dMatch[1];
              mo = parseInt(dMatch[2], 10) || 1;
            }
          }

          const engRaw = String(r['服務人員'] || '未填').trim() || '未填';
          const primaryEng = engRaw.split(',')[0].trim() || '未填';
          const hoursVal = parseFloat(r['工時']);

          rawRecords.push({
            uKey: `${yr}-${orderId}-${Date.now()}-${idx}`,
            id: orderId || `ROW-${idx}`,
            year: yr,
            month: mo,
            dateStr: rawDate.slice(0, 16),
            status: String(r['狀態'] || '未填').trim() || '未填',
            region: String(r['服務區域'] || '未填').trim() || '未填',
            brand: String(r['產品分類'] || '未填').trim() || '未填',
            productName: String(r['產品名稱'] || '未填').trim() || '未填',
            serial: String(r['產品序號'] || '').trim(),
            serviceCat: normalizeServiceCat(r['服務類別']),
            rawServiceCat: String(r['服務類別'] || '未填').trim(),
            warranty: normalizeWarranty(r['保固/維護合約']),
            rawWarranty: String(r['保固/維護合約'] || '未填').trim(),
            engineer: primaryEng,
            allEngineers: engRaw,
            hours: isNaN(hoursVal) ? 0 : Math.round(hoursVal * 100) / 100,
            result: String(r['服務結果確認'] || '未填').trim() || '未填',
            desc: String(r['報修內容'] || '').trim().slice(0, 120),
            repairDesc: String(r['維修內容'] || '').trim().slice(0, 150)
          });
          addedRows++;
        });
      }

      if (document.getElementById('chkDedupe').checked) {
        // 正規化單號 (去除開頭 0 以避免 006267 與 6267 重複)，但若單號相同且連產品序號與服務日期都不同(如 2025 年有兩筆 006806-1)，則保留
        const map = new Map();
        rawRecords.forEach(item => {
          const normId = item.id.replace(/^0+/, '') || item.id;
          const dedupeKey = `${item.year}-${normId}-${item.dateStr}-${item.serial}`;
          map.set(dedupeKey, item);
        });
        rawRecords = Array.from(map.values());
      }

      updateLatestDateStatus(addedRows);

      populateFilterOptions();
      updateDashboard();
    });

    function populateFilterOptions() {
      const excludeCancelled = document.getElementById('chkExcludeCancelled').checked;
      const baseRecords = rawRecords.filter(r => {
        if (excludeCancelled && (r.status === '測試與教學' || r.status === '已取消')) return false;
        return true;
      });

      const fillSelect = (id, key, defaultLabel) => {
        const sel = document.getElementById(id);
        const currentVal = sel.value;
        const counts = {};
        baseRecords.forEach(r => {
          if (key === 'engineer') {
            // 支援多工程師拆分 (如 "馮培瑄,湯晨瑜")
            const engs = String(r.allEngineers || r.engineer || '未填').replace(/，/g, ',').split(',');
            engs.forEach(en => {
              const name = en.trim();
              if (name) { counts[name] = (counts[name] || 0) + 1; }
            });
          } else {
            counts[r[key]] = (counts[r[key]] || 0) + 1;
          }
        });
        const sortedKeys = Object.keys(counts).sort((a, b) => {
          if (key === 'year') return a.localeCompare(b);
          return counts[b] - counts[a];
        });
        sel.innerHTML = `<option value="ALL">${defaultLabel} (${baseRecords.length})</option>` +
          sortedKeys.map(k => `<option value="${k}">${k} (${counts[k]})</option>`).join('');
        if (sortedKeys.includes(currentVal)) sel.value = currentVal;
      };

      fillSelect('fltYear', 'year', '全部年度');
      fillSelect('fltRegion', 'region', '全部區域');
      fillSelect('fltServiceCat', 'serviceCat', '全部類別');
      fillSelect('fltWarranty', 'warranty', '全部合約狀態');
      fillSelect('fltBrand', 'brand', '全部品牌');
      fillSelect('fltEngineer', 'engineer', '全部工程師');
      fillSelect('fltStatus', 'status', '全部狀態');
    }

